{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "fcc-spectrum-mcp-server",
  "version": "0.1.0",
  "description": "FCC radio spectrum licensing from the Universal Licensing System: search callsigns and licenses, licensed frequencies, and transmitter locations.",
  "author": {
    "name": "Casey Hand",
    "email": "casey@caseyjhand.com",
    "url": "https://caseyjhand.com"
  },
  "homepage": "https://github.com/cyanheads/fcc-spectrum-mcp-server",
  "repository": "https://github.com/cyanheads/fcc-spectrum-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "fcc", "spectrum", "radio", "rf", "uls", "callsign", "wireless", "amateur-radio"],
  "mcpServers": {
    "fcc-spectrum-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/fcc-spectrum-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
